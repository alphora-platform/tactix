NODE_ENV=development

# App
APP_URL=http://localhost:3000
PORT=5500

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tactix
POSTGRES_SYNCHRONIZE=false
POSTGRES_DROP_SCHEMA=false

# Riot development keys
RIOT_API_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Admin seed (used by APP_MODE=seed-admin)
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
