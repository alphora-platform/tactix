{
  "name": "@org/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "typeorm": "../../node_modules/.bin/ts-node --project tsconfig.app.json ../../node_modules/.bin/typeorm",
    "migration:run": "npm run typeorm -- migration:run -d src/modules/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/modules/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/modules/database/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/modules/database/data-source.ts"
  },
  "nx": {
    "name": "api",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "cache": false,
        "outputs": [
          "{workspaceRoot}/apps/api/dist"
        ],
        "options": {
          "command": "npx webpack-cli build --node-env={args.nodeEnv}",
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "args": "--nodeEnv=development"
          },
          "production": {
            "args": "--nodeEnv=production"
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development"
          },
          "production": {
            "buildTarget": "api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "migration:run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run migration:run",
          "cwd": "apps/api"
        }
      },
      "migration:revert": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run migration:revert",
          "cwd": "apps/api"
        }
      },
      "migration:generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run migration:generate",
          "cwd": "apps/api"
        }
      },
      "migration:show": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm run migration:show",
          "cwd": "apps/api"
        }
      }
    }
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/schedule": "^6.1.1",
    "bullmq": "^5.70.1",
    "ioredis": "^5.9.3"
  }
}
