# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5500
APP_URL=https://yourdomain.com

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tactix
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
POSTGRES_DB=tactix
POSTGRES_SYNCHRONIZE=false
POSTGRES_DROP_SCHEMA=false
# Set to true if using Supabase or a hosted PG with SSL required
POSTGRES_SSL=false

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_A_256_BIT_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_USE_A_STRONG_RANDOM_KEY

# ─── Riot API ─────────────────────────────────────────────────────────────────
RIOT_API_KEY=RGAPI-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_CREDENTIALS=true

# ─── Docker image config (used by docker-compose.prod.yml) ────────────────────
# Your GitHub username or organisation
GITHUB_OWNER=your-github-username
GITHUB_REPO=tactix
IMAGE_TAG=latest
